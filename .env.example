# Número de WhatsApp de la imprenta: código de país y área, solo dígitos.
# Confirmar el número antes de habilitar el envío.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Conexión pública a Supabase. Nunca usar una service_role o secret key aquí.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Mantener desactivado hasta completar Google y las políticas de ingreso.
GOOGLE_AUTH_ENABLED=false
